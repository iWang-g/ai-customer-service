# Copy to .env on the server and keep mode 0600.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-12-characters
DEFAULT_ADMIN_DISPLAY_NAME=Administrator
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ALLOW_ORIGINS=null
LOG_LEVEL=INFO
PDD_MESSAGE_SNAPSHOT_WRITE_ENABLED=true
# Optional JSON override for versioned selectors and classification rules.
PDD_COLLECTOR_RULES_JSON=

# Leave empty for a new Knowledge Base database. Only set this when migrating
# legacy unowned knowledge bases to a confirmed Business API user ID.
KB_LEGACY_OWNER_USER_ID=

# First release defaults to the local fallback provider. Configure these when
# the server should call an external OpenAI-compatible model directly.
AI_PROVIDER=local
AI_MODEL=deepseek-v4-flash
AI_PROVIDER_BASE_URL=https://api.deepseek.com
AI_PROVIDER_API_KEY=
DEEPSEEK_API_KEY=
AI_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT_SECONDS=20
KNOWLEDGE_BASE_PUBLIC_URL=http://43.139.142.142/kb-api

# Optional path on a separately mounted disk/NAS. Empty keeps daily backups
# only under /opt/backups/ai-customer-service on the same server.
OFFSITE_BACKUP_DIR=
