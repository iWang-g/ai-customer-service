KB_HOST=0.0.0.0
KB_PORT=8010
KB_DATABASE_PATH=./data/knowledge-base.db
KB_ASSET_PATH=./data/assets
KB_LOG_LEVEL=INFO
KB_CORS_ALLOW_ORIGINS=null
KB_EMBEDDING_ENABLED=true
KB_EMBEDDING_PROVIDER=fastembed
KB_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
KB_EMBEDDING_CACHE_PATH=./data/models
KB_EMBEDDING_LOCAL_FILES_ONLY=true
KB_EMBEDDING_BATCH_SIZE=16
KB_VECTOR_SEARCH_ENABLED=true
KB_VECTOR_MIN_SCORE=0.5
KB_VECTOR_CANDIDATE_LIMIT=80
KB_HYBRID_FTS_LIMIT=80
KB_HYBRID_RRF_K=60

# Must exactly match Business API JWT_SECRET_KEY.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes

# Required once when upgrading a database that already contains knowledge bases.
# Use the Business API user ID that should own all existing knowledge data.
KB_LEGACY_OWNER_USER_ID=
