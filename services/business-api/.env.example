ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/business-api.db
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
SEED_DEMO_DATA=true
CORS_ALLOW_ORIGINS=http://127.0.0.1:9527,http://localhost:9527,null
PDD_MESSAGE_SNAPSHOT_WRITE_ENABLED=false
# Optional JSON override for versioned selectors and classification rules.
PDD_COLLECTOR_RULES_JSON=
AI_PROVIDER=deepseek
AI_PROVIDER_BASE_URL=https://api.deepseek.com
AI_PROVIDER_API_KEY=

# Production must use ENVIRONMENT=production, a random JWT secret (32+ chars),
# a non-default admin password (12+ chars), and SEED_DEMO_DATA=false.
