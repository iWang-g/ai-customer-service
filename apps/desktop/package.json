{
  "name": "@ai-customer-service/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "AI customer service desktop application",
  "author": "OmniAI",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 9527\" \"wait-on http://127.0.0.1:9527 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:9527 electron .\"",
    "build": "vite build",
    "build:icon": "node scripts/build-icon.mjs",
    "build:rpa": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-rpa.ps1",
    "validate:release": "node scripts/validate-release-config.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "test:runtime-config": "node scripts/test-runtime-config.mjs",
    "test:message-notice": "node scripts/test-message-notice.mjs",
    "smoke:message-notice": "electron scripts/smoke-message-notice.mjs",
    "test:rpa-executable": "node scripts/test-rpa-executable.mjs",
    "lint": "tsc --noEmit",
    "smoke:pdd-workspace": "electron scripts/smoke-pdd-workspace.mjs",
    "smoke:douyin-workspace": "electron scripts/smoke-douyin-workspace.mjs",
    "test:douyin-navigation": "node scripts/test-douyin-navigation.mjs",
    "test:douyin-observer": "node scripts/test-douyin-observer.mjs",
    "test:douyin-mapper": "node scripts/test-douyin-mapper.mjs && node scripts/test-douyin-message-core.mjs",
    "test:douyin-sender": "node scripts/test-douyin-sender.mjs",
    "test:douyin-products": "node --test scripts/test-douyin-products.mjs scripts/test-douyin-product-details.mjs",
    "test:douyin-orders": "node --test scripts/test-douyin-orders.mjs",
    "test:douyin-transfer": "node --test scripts/test-douyin-transfer.mjs scripts/test-douyin-transfer-observer.mjs scripts/test-douyin-transfer-client.mjs scripts/test-douyin-auto-transfer.mjs",
    "smoke:pdd-adapter": "electron scripts/smoke-pdd-adapter.mjs",
    "test:pdd-context-transfer": "node scripts/test-pdd-context-transfer.mjs",
    "test:pdd-api-adapter": "node scripts/test-pdd-api-adapter.mjs",
    "test:pdd-collector": "node scripts/test-pdd-collector.mjs",
    "test:qianniu-adapter": "node scripts/test-qianniu-adapter.mjs",
    "test:qianniu-transfer": "node --test electron/qianniu/transfer.test.mjs",
    "test:store-actor": "node scripts/test-store-actor.mjs",
    "test:pdd-session-health": "electron scripts/test-pdd-session-health.mjs",
    "test:wechat-process-manager": "node scripts/test-wechat-process-manager.mjs",
    "start": "electron .",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "dist:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -RuntimeConfigFile config/local.json",
    "dist:remote": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -RuntimeConfigFile config/remote.json"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.omniai.customer-service",
    "productName": "AI智能客服-拼多多试用版",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "copyright": "Copyright © 2026 OmniAI",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release-windows"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../agents/rpa/dist",
        "to": "rpa",
        "filter": [
          "rpa-agent.exe"
        ]
      },
      {
        "from": "config/release.json",
        "to": "runtime-config.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/app-icon.ico",
      "executableName": "AI智能客服-拼多多试用版",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "build/app-icon.ico",
      "uninstallerIcon": "build/app-icon.ico",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI智能客服-拼多多试用版",
      "uninstallDisplayName": "AI智能客服-拼多多试用版 ${version}",
      "deleteAppDataOnUninstall": false
    },
    "forceCodeSigning": false
  }
}
